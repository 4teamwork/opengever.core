#!/usr/local/bin/python2.7
import sys
import os
os.environ['MSGCONVERT_URL'] = 'http://msgconvert:8090/'
os.environ['SABLON_URL'] = 'http://sablon:8080/'
os.environ['PDFLATEX_URL'] = 'http://pdflatex:8080/'
os.environ['WEASYPRINT_URL'] = 'http://weasyprint:8080/'
os.environ['SIGN_SERVICE_URL'] = 'http://ogsign:8080/'
# Enable conditional readonly patches during tests
os.environ['GEVER_READ_ONLY_MODE'] = 'true'

os.environ['zope_i18n_compile_mo_files'] = 'true'
chameleon_cache_dir = '/app/var/chameleon-cache'
try:
    os.makedirs(chameleon_cache_dir)
except OSError:
    pass
os.environ['CHAMELEON_CACHE'] = chameleon_cache_dir


# Enable c.indexing during tests, but patch it to not defer operations
from opengever.testing.patch import patch_collective_indexing
patch_collective_indexing()
from collective.indexing import monkey

# Patch readonly support onto DemoStorage during tests
from opengever.testing.patch import patch_demostorage_to_support_readonly_mode
patch_demostorage_to_support_readonly_mode()

import collective.xmltestreport.runner
if __name__ == '__main__':
    sys.exit(collective.xmltestreport.runner.run(([
        '-s',
        'opengever',
        '--exit-with-status',
        '--auto-color',
        '--auto-progress',
        '--xml',
        '--test-path',
        '/app',
        '--test-path',
        '/app/src/opengever.maintenance',
    ])))
